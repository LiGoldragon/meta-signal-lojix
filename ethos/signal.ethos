; Privileged Lojix query and response contract.
;
; Each input's own output is named in its past tense and stands at its
; position: Configured, ConfigurationReversed, Retired, Pinned,
; DeployAccepted, Tested, Unpinned. DeployAccepted acknowledges a deployment
; at admission; the deployment's own end follows as the reaction
; DeployTerminal. The rejections follow the outputs in the order of the
; inputs they answer, then DeployTerminal, then Refused, which answers any
; input the Nexus's store could not carry out, with the store's own words.
;
; Every enumeration lists its variants in the order Lojix stores them, so a
; stored value keeps its archived tag.
Signal

[ horizon_lib:[ HorizonDefinition ] signal_lojix:[ UserEnvironmentAction GenerationIdentifier ProposalSource SecretsInput NodeName DeploymentRecord HostDeployAction PinLabel GenerationSlot TestRunIdentifier HostComposition DatabaseMarker UserName NixBuilderSpec DeploymentInputMode DeploymentTransport TestExecutionProfile ActivationBackend HostSelection DeploymentOutputSelector TestMode SourceRevisionPolicy ClusterName DeploymentIdentifier FlakeReference LojixNexusConfiguration ConfigurationReceipt ConfigurationRejection StoreFailure ] ]

[ Configure.LojixNexusConfiguration
  ReverseConfiguration
  Retire.RetireRequest
  Pin.PinRequest
  Deploy.ActualizedDeploySubmission
  Test.TestRequest
  Unpin.UnpinRequest ]

[ Configured.ConfigurationReceipt
  ConfigurationReversed.ConfigurationReceipt
  Retired.AppliedRetire
  Pinned.AppliedPin
  DeployAccepted.DeployHandle
  Tested.AcceptedTest
  Unpinned.AppliedUnpin
  ConfigurationRejected.ConfigurationRejection
  RetireRejected.RejectedRetire
  PinRejected.RejectedPin
  DeployRejected.RejectedDeploy
  DeployRefused.RefusedDeploy
  TestRejected.RejectedTest
  UnpinRejected.RejectedUnpin
  DeployTerminal.DeploymentRecord
  Refused.StoreFailure ]

[ UserEnvironmentDeployment.{ ClusterName NodeName UserName ProposalSource SecretsInput FlakeReference DeploymentTransport DeploymentInputMode DeploymentOutputSelector ActivationBackend UserEnvironmentAction SourceRevisionPolicy Option<NixBuilderSpec> Vector<ExtraSubstituter> }
  HostDeployment.{ ClusterName NodeName HostComposition ProposalSource SecretsInput FlakeReference DeploymentTransport DeploymentInputMode DeploymentOutputSelector ActivationBackend HostDeployAction SourceRevisionPolicy Option<NixBuilderSpec> Vector<ExtraSubstituter> }
  ActualizedDeploySubmission.{ DeploySubmission Option<HorizonDefinition> }
  ClientQuery.[ Configure.LojixNexusConfiguration ReverseConfiguration Retire.RetireRequest Pin.PinRequest Deploy.DeploySubmission Test.TestRequest Unpin.UnpinRequest ]
  AppliedPin.{ GenerationIdentifier PinLabel GenerationSlot GenerationSlot DatabaseMarker }
  PinRejectionReason.[ GenerationUnknown NodeUnknown PinLabelInUse PinSlotExhausted InternalError ]
  NodeSelection.[ Nodes.Vector<NodeName> All ]
  RetireRejectionReason.[ GenerationUnknown NodeUnknown GenerationActive GenerationPinned InternalError ]
  RejectedTest.{ TestRejectionReason DatabaseMarker }
  RejectedDeploy.{ DeploymentRecord }
  RefusedDeploy.{ DeployRefusalReason DatabaseMarker }
  DeployRefusalReason.[ ContinuationBudgetExhausted NoCorrelatedDeployment DurableWriteFailed ]
  UnpinRejectionReason.[ PinLabelUnknown NodeUnknown GenerationNotPinned InternalError ]
  PinRequest.{ ClusterName NodeName GenerationIdentifier PinLabel }
  RejectedUnpin.{ UnpinRejectionReason DatabaseMarker }
  TestRequest.[ Run.TestRun Check.QuickCheck ]
  RejectedPin.{ PinRejectionReason DatabaseMarker }
  UnpinRequest.{ ClusterName NodeName PinLabel }
  ExtraSubstituter.{ String String }
  DeployHandle.{ DeploymentIdentifier DatabaseMarker }
  RetireRequest.{ ClusterName NodeName GenerationIdentifier }
  DeploySubmission.[ Host.HostDeployment UserEnvironment.UserEnvironmentDeployment ]
  QuickCheck.Vector<NodeName>
  AcceptedTest.{ TestRunIdentifier DatabaseMarker }
  AppliedUnpin.{ GenerationIdentifier PinLabel GenerationSlot GenerationSlot DatabaseMarker }
  TestRejectionReason.[ ClusterUnknown NodeUnknown VmHostNotDeclaredForNode HostDeclaresNoVmHost NoTestDefaults LiveNotYetEnabled SubstrateUnavailable InternalError ]
  RejectedRetire.{ RetireRejectionReason DatabaseMarker }
  AppliedRetire.{ GenerationIdentifier GenerationSlot DatabaseMarker }
  TestRun.{ ClusterName NodeSelection HostSelection TestExecutionProfile } ]
